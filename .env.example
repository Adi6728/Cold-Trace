# Example environment variables for local development
# Do not commit real credentials.
POSTGRES_DB=coldchain_trace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/coldchain_trace

ENVIRONMENT=development
ADMIN_REGISTRATION_KEY=1234

# Anomaly Detection Settings
ALERT_CRITICAL_DEVIATION=5.0
ALERT_HIGH_DEVIATION=2.0
ALERT_MEDIUM_DEVIATION=0.5
ALERT_DURATION_MINUTES=15

# Hyperledger Fabric Settings
# Replace 'C:/fabric' with your actual fabric installation path
FABRIC_CLI_BIN_DIR="C:/fabric/fabric-samples/bin"
FABRIC_CFG_PATH="C:/fabric/fabric-samples/config"
FABRIC_ORDERER_URL="localhost:7050"
FABRIC_ORDERER_TLS_CA="C:/fabric/fabric-samples/test-network/organizations/ordererOrganizations/example.com/tlsca/tlsca.example.com-cert.pem"
FABRIC_PEER_ADDRESSES="localhost:7051,localhost:9051"
FABRIC_PEER_TLS_CAS="C:/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt,C:/fabric/fabric-samples/test-network/organizations/peerOrganizations/org2.example.com/peers/peer0.org2.example.com/tls/ca.crt"
FABRIC_MSP_DIR="C:/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp"
FABRIC_MSP_ID="Org1MSP"
FABRIC_CHANNEL="tracechannel"
FABRIC_CHAINCODE="traceability"

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
